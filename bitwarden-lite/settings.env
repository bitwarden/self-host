#####################
# Required Settings #
#####################

# Server hostname
BW_DOMAIN=bitwarden.example.com

# Database
# Available providers are sqlserver, postgresql, mysql/mariadb, or sqlite
BW_DB_PROVIDER=mysql
BW_DB_SERVER=db
BW_DB_DATABASE=bitwarden_vault
BW_DB_USERNAME=bitwarden
BW_DB_PASSWORD=super_strong_password

# Installation information
# Get your ID and key from https://bitwarden.com/host/
BW_INSTALLATION_ID=00000000-0000-0000-0000-000000000000
BW_INSTALLATION_KEY=xxxxxxxxxxxx

#####################
# Optional Settings #
#####################
# Learn more here: https://bitwarden.com/help/environment-variables/

# Container user ID/group ID
# (only used when the container starts as root; ignored when the container
# is started with a specific user, e.g. compose's "user:")
#PUID=911
#PGID=911

# IPV6
#BW_ENABLE_IPV6=true

# Webserver ports
#BW_PORT_HTTP=8080
#BW_PORT_HTTPS=8443

# SSL
#BW_ENABLE_SSL=true
#BW_ENABLE_SSL_CA=true
#BW_SSL_CERT=ssl.crt
#BW_SSL_KEY=ssl.key
#BW_SSL_CA_CERT=ca.crt

# Services
# Some services, namely for enterprise use cases, are disabled by default. Defaults shown below.
#BW_ENABLE_ADMIN=true
#BW_ENABLE_API=true
#BW_ENABLE_EVENTS=false
#BW_ENABLE_ICONS=true
#BW_ENABLE_IDENTITY=true
#BW_ENABLE_NOTIFICATIONS=true
#BW_ENABLE_SCIM=false
#BW_ENABLE_SSO=false

#BW_ICONS_PROXY_TO_CLOUD=false

# Mail
#globalSettings__mail__replyToEmail=noreply@$BW_DOMAIN
#globalSettings__mail__smtp__host=smtphost.example.com
#globalSettings__mail__smtp__port=587
#globalSettings__mail__smtp__ssl=false
#globalSettings__mail__smtp__username=smtpusername
#globalSettings__mail__smtp__password=smtppassword

# Yubikey
#globalSettings__yubico__clientId=REPLACE
#globalSettings__yubico__key=REPLACE

# Other
#globalSettings__disableUserRegistration=false
#globalSettings__hibpApiKey=REPLACE
#globalSettings__sqlServer__migrationExecutionTimeoutSeconds=900
#adminSettings__admins=admin1@email.com,admin2@email.com

# Backups
# The application container takes one backup per interval, containing the
# database dump, /etc/bitwarden (excluding logs) and a manifest. All of it is
# required to restore; see backup/README.md. Covers mysql/mariadb and sqlite.
#
# Set to 0 to disable backups entirely. Matches standard self-host.
#BACKUP_DB=1
# When to run. Defaults reproduce standard self-host: once a day at midnight
# UTC. The time of day lives in BACKUP_INTERVAL_FORMAT — "%Y-%m-%d 03:00:00"
# runs at 03:00 in BACKUP_TIMEZONE.
#BACKUP_INTERVAL=next day
#BACKUP_INTERVAL_FORMAT=%Y-%m-%d 00:00:00
#BACKUP_TIMEZONE=UTC
# Also take a backup immediately on container start. This is not a pre-upgrade
# backup: it runs in the new container, while database migrations may still be
# running. Before an upgrade, run /backup-db.sh in the old container instead;
# see backup/README.md.
#BACKUP_ON_START=0
# Delete archives older than this many days (0 disables the sweep). Standard
# self-host hard-codes the equivalent at 32 days; here it is configurable. Old
# archives are only ever deleted after a new archive has been written and
# verified, so a failed backup never costs you the ones you already have.
#BACKUP_RETENTION_DAYS=32
# Mode of the finished archive. 600 means only the user the application runs as
# can read it, which also means copying backups off the host needs root. Use 640
# if the process that copies them off-box shares the container's group. The
# archive holds the plaintext data-protection keys as well as the encrypted
# vault, so treat loosening this as a security decision.
#BACKUP_FILE_MODE=600
# Include settings.env in each archive. Requires mounting it into the container
# at /settings.env. Makes the archive self-sufficient and more sensitive.
#BACKUP_INCLUDE_SETTINGS=false
# Connection options for every database client call, backup and restore alike,
# e.g. --skip-ssl against a server without TLS.
#BACKUP_DB_CLIENT_ARGS=
# Extra options for mariadb-dump only (not used by the restore).
#BACKUP_DB_EXTRA_ARGS=
